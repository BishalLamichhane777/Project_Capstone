# WARNING: Copy this file to .env and fill in real values. 
# NEVER commit .env to version control!

# Flask
FLASK_ENV=production
FLASK_PORT=5000
SECRET_KEY=change-me-to-a-long-random-string

# Database
DATABASE_URL=sqlite:////app/database/attendance.db
SQLALCHEMY_DATABASE_URI=sqlite:////app/database/attendance.db

# Firebase
FIREBASE_CREDENTIALS_PATH=/app/firebase_credentials.json
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com

# OpenCV / Facial Recognition
RECOGNITION_THRESHOLD=80
HAAR_CASCADE_PATH=/usr/local/lib/python3.12/dist-packages/cv2/data/haarcascade_frontalface_default.xml
LBPH_MODELS_PATH=/app/models_storage
STRICT_MODE_THRESHOLD=60
ACTIVITY_MODE_THRESHOLD=80

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:8081
CORS_ORIGINS=http://localhost:8081

# Auth
JWT_EXPIRY_HOURS=24

# Flask Admin
FLASK_ADMIN_SWATCH=cerulean

# Security
WTF_CSRF_ENABLED=True
