# Copy this file to .env and fill in your real values. NEVER commit .env to Git.

# --- Flask ---
FLASK_ENV=development
FLASK_PORT=5000
SECRET_KEY=replace_with_a_long_random_secret

# --- Database ---
DATABASE_URL=sqlite:///./database/attendance.db

# --- Face Recognition ---
# Team agreed: LBPH confidence threshold is 70 (lower = stricter match)
# A face is only accepted as identified if confidence score is LESS than this value
RECOGNITION_THRESHOLD=70
HAAR_CASCADE_PATH=./haarcascade_frontalface_default.xml
LBPH_MODELS_PATH=./models_storage

# --- CORS ---
# Add your Expo dev server addresses here
CORS_ALLOWED_ORIGINS=http://localhost:19006,http://localhost:8081,http://10.0.2.2:5000
